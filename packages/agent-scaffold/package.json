{
  "name": "@agent-corpus/agent-scaffold",
  "version": "0.1.0",
  "description": "Create portable skill and agent silhouettes with canonical instructions and native discovery adapters.",
  "keywords": [
    "coding-agent",
    "scaffold",
    "cli"
  ],
  "license": "MIT",
  "author": "agent-corpus contributors",
  "homepage": "https://github.com/agent-corpus/tools/tree/main/packages/agent-scaffold#readme",
  "bugs": "https://github.com/agent-corpus/tools/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-corpus/tools.git",
    "directory": "packages/agent-scaffold"
  },
  "type": "module",
  "bin": {
    "agent-scaffold": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run clean && npm run build && node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\"",
    "postpack": "node -e \"require('fs').rmSync('LICENSE',{force:true})\""
  }
}
